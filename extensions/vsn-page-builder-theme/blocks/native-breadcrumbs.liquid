<div class="vsn-native-block" data-vsn-native-instance="{{ block.id }}" style="--vsn-native-color:{{ block.settings.color }};--vsn-native-bg:{{ block.settings.background }};--vsn-native-py:{{ block.settings.padding_y }}px;--vsn-native-px:{{ block.settings.padding_x }}px"><nav aria-label="Breadcrumb"><a href="{{ routes.root_url }}">{{ block.settings.home }}</a>{% if product %} / {{ product.title }}{% elsif collection %} / {{ collection.title }}{% elsif page %} / {{ page.title }}{% endif %}</nav></div>

{% schema %}
{
  "name": "Breadcrumbs",
  "target": "section",
  "stylesheet": "native-blocks.css",
  "available_if": "{{ app.metafields.vsn_page_builder.breadcrumbs_enabled }}",
  "settings": [
    {
      "type": "text",
      "id": "home",
      "label": "Home label",
      "default": "Home"
    },
    {
      "type": "color",
      "id": "color",
      "label": "Text color",
      "default": "#1a1a1a"
    },
    {
      "type": "color_background",
      "id": "background",
      "label": "Background"
    },
    {
      "type": "range",
      "id": "padding_y",
      "label": "Vertical padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_x",
      "label": "Horizontal padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    }
  ]
}
{% endschema %}
