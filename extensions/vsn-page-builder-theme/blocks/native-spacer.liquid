<div class="vsn-native-block" data-vsn-native-instance="{{ block.id }}" style="height:{{ block.settings.height }}px" aria-hidden="true"></div>

{% schema %}
{
  "name": "Spacer",
  "target": "section",
  "stylesheet": "native-blocks.css",
  "available_if": "{{ app.metafields.vsn_page_builder.spacer_enabled }}",
  "settings": [
    {
      "type": "range",
      "id": "height",
      "label": "Height",
      "min": 4,
      "max": 300,
      "step": 4,
      "unit": "px",
      "default": 48
    }
  ]
}
{% endschema %}
