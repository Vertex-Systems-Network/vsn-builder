<div class="vsn-native-block" data-vsn-native-instance="{{ block.id }}" style="--vsn-native-color:{{ block.settings.color }};--vsn-native-bg:{{ block.settings.background }};--vsn-native-py:{{ block.settings.padding_y }}px;--vsn-native-px:{{ block.settings.padding_x }}px"><a class="vsn-native-button" href="{{ block.settings.url }}"{% if block.settings.new_tab %} target="_blank" rel="noopener"{% endif %} style="--vsn-native-accent:{{ block.settings.background_button }}">{{ block.settings.text }}</a></div>

{% schema %}
{
  "name": "Button",
  "target": "section",
  "stylesheet": "native-blocks.css",
  "available_if": "{{ app.metafields.vsn_page_builder.button_enabled }}",
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "Label",
      "default": "Shop now"
    },
    {
      "type": "url",
      "id": "url",
      "label": "Link"
    },
    {
      "type": "checkbox",
      "id": "new_tab",
      "label": "Open in new tab",
      "default": false
    },
    {
      "type": "color",
      "id": "background_button",
      "label": "Button color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "color",
      "label": "Text color",
      "default": "#1a1a1a"
    },
    {
      "type": "color_background",
      "id": "background",
      "label": "Background"
    },
    {
      "type": "range",
      "id": "padding_y",
      "label": "Vertical padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_x",
      "label": "Horizontal padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    }
  ]
}
{% endschema %}
