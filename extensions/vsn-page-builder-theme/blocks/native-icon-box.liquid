<div class="vsn-native-block" data-vsn-native-instance="{{ block.id }}" style="--vsn-native-color:{{ block.settings.color }};--vsn-native-bg:{{ block.settings.background }};--vsn-native-py:{{ block.settings.padding_y }}px;--vsn-native-px:{{ block.settings.padding_x }}px"><div class="vsn-native-row"><span aria-hidden="true">{{ block.settings.icon }}</span><div><strong>{{ block.settings.heading }}</strong><div class="vsn-native-muted">{{ block.settings.text }}</div></div></div></div>

{% schema %}
{
  "name": "Icon box",
  "target": "section",
  "stylesheet": "native-blocks.css",
  "available_if": "{{ app.metafields.vsn_page_builder.icon_box_enabled }}",
  "settings": [
    {
      "type": "text",
      "id": "icon",
      "label": "Icon / symbol",
      "default": "\u2605"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Feature"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Describe this feature."
    },
    {
      "type": "color",
      "id": "color",
      "label": "Text color",
      "default": "#1a1a1a"
    },
    {
      "type": "color_background",
      "id": "background",
      "label": "Background"
    },
    {
      "type": "range",
      "id": "padding_y",
      "label": "Vertical padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_x",
      "label": "Horizontal padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    }
  ]
}
{% endschema %}
