<div class="vsn-native-block" data-vsn-native-instance="{{ block.id }}" style="--vsn-native-color:{{ block.settings.color }};--vsn-native-bg:{{ block.settings.background }};--vsn-native-py:{{ block.settings.padding_y }}px;--vsn-native-px:{{ block.settings.padding_x }}px"><div class="vsn-native-countdown" data-vsn-countdown="{{ block.settings.end }}"><span><b data-vsn-days>--</b><small> Days</small></span><span><b data-vsn-hours>--</b><small> Hours</small></span><span><b data-vsn-minutes>--</b><small> Min</small></span></div></div>

{% schema %}
{
  "name": "Countdown",
  "target": "section",
  "stylesheet": "native-blocks.css",
  "available_if": "{{ app.metafields.vsn_page_builder.countdown_enabled }}",
  "settings": [
    {
      "type": "text",
      "id": "end",
      "label": "End ISO date/time",
      "default": "2026-12-31T23:59:59Z"
    },
    {
      "type": "color",
      "id": "color",
      "label": "Text color",
      "default": "#1a1a1a"
    },
    {
      "type": "color_background",
      "id": "background",
      "label": "Background"
    },
    {
      "type": "range",
      "id": "padding_y",
      "label": "Vertical padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_x",
      "label": "Horizontal padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    }
  ],
  "javascript": "native-blocks.js"
}
{% endschema %}
