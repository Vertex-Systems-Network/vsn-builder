# VSN Builder development environment template
# Never commit real production credentials. Keep secret values blank here and load them from a local .env or deployment secret store.

DATABASE_URL=file:./dev.sqlite
SHOPIFY_APP_URL=
HOST=
SCOPES=

# Production Shopify application identity/origin used by the production config generator/readiness checks.
# Keep these environment-specific and never commit real credentials.
SHOPIFY_PRODUCTION_APP_URL=
SHOPIFY_PRODUCTION_CLIENT_ID=

# AI Builder is disabled by default. Set a real key only in your local/deployment secret store.
OPENAI_API_KEY=
VSN_AI_MODEL=gpt-5-mini
VSN_FEATURE_AI_BUILDER=false

# Experimental feature flags. Developer SDK and enterprise hardening are enabled in this development example because their release QA suites validate those surfaces.
VSN_FEATURE_NATIVE_SECTION_BRIDGE=false
VSN_FEATURE_LIVE_E2E_HOOKS=false
VSN_FEATURE_QUERY_BUILDER_V2=false
VSN_FEATURE_COMPONENT_VARIANTS=false
VSN_FEATURE_RESPONSIVE_V2=false
VSN_FEATURE_COLLABORATION_REVIEW=false
VSN_FEATURE_LOCALIZATION_MARKETS=false
VSN_FEATURE_FORMS_AUTOMATION=false
VSN_FEATURE_MARKETPLACE_BRAND_KITS=false
VSN_FEATURE_DEVELOPER_SDK=true
VSN_FEATURE_ENTERPRISE_HARDENING=true
VSN_FEATURE_COMMERCIALIZATION=false

# Developer-plan simulation. Leave blank to use the built-in development default; never hard-code a paid tier in source.
VSN_DEFAULT_PLAN=

# Shopify hosted App Pricing destination. Configure these per deployed app/environment.
SHOPIFY_APP_HANDLE=
SHOPIFY_APP_PRICING_URL=

# Public Shopify App Pricing plan handles. Leave blank to use the application's built-in handle mapping, or set the exact handles configured in Shopify.
SHOPIFY_APP_PRICING_PLAN_FREE_HANDLE=
SHOPIFY_APP_PRICING_PLAN_SILVER_HANDLE=
SHOPIFY_APP_PRICING_PLAN_GOLD_HANDLE=
SHOPIFY_APP_PRICING_PLAN_PLATINUM_HANDLE=

# Legacy fallback only. Prefer SHOPIFY_APP_HANDLE and SHOPIFY_APP_PRICING_URL for new deployments.
SHOPIFY_MANAGED_PRICING_URL=

# Form anti-abuse providers. Secrets must stay out of source control.
VSN_TURNSTILE_SECRET_KEY=
VSN_HCAPTCHA_SECRET_KEY=

# Optional outbound automation hooks. Only public HTTPS endpoints are accepted at runtime.
VSN_FORM_EMAIL_WEBHOOK_URL=
VSN_FORM_EMAIL_WEBHOOK_SECRET=
VSN_FORM_FILE_SCAN_WEBHOOK=
