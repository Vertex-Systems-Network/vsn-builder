# VSN developer-mode example configuration.
# Copy only the settings you need into a local .env file; never commit secrets.

# Phase 14 developer SDK example.
VSN_FEATURE_DEVELOPER_SDK=true

# Phase 15 enterprise hardening example.
VSN_FEATURE_ENTERPRISE_HARDENING=true

# Phase 16 commercialization remains disabled by default in local examples.
VSN_FEATURE_COMMERCIALIZATION=false
VSN_DEFAULT_PLAN=
SHOPIFY_APP_HANDLE=
SHOPIFY_APP_PRICING_URL=
