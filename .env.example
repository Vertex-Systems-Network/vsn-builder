# VSN Builder development environment template
# Never commit real production credentials. Keep secret values blank here and load them from a local .env or deployment secret store.

DATABASE_URL=file:./dev.sqlite
SHOPIFY_APP_URL=
HOST=
SCOPES=

# Production Shopify application identity/origin used by the production config generator/readiness checks.
# Keep these environment-specific and never commit real credentials.
SHOPIFY_PRODUCTION_APP_URL=
SHOPIFY_PRODUCTION_CLIENT_ID=

# AI Builder is disabled by default. Set a real key only in your local/deployment secret store.
OPENAI_API_KEY=
VSN_AI_PROVIDER=openai
VSN_AI_MODEL=gpt-5-mini
VSN_AI_TIMEOUT_MS=45000
VSN_AI_MAX_RETRIES=0
VSN_AI_PAGE_BEHAVIOR_VERSION=page-v1
VSN_AI_EMAIL_BEHAVIOR_VERSION=email-v1
VSN_AI_AGENT_BEHAVIOR_VERSION=agent-v1
VSN_AI_AGENT_CONTEXT_BEHAVIOR_VERSION=agent-v2
VSN_AI_REFERENCE_BEHAVIOR_VERSION=reference-v1
VSN_AI_BRAND_BEHAVIOR_VERSION=brand-extract-v1
VSN_FEATURE_AI_BUILDER=false
VSN_FEATURE_AI_AGENT_CONTEXT_TOOLS=false
VSN_FEATURE_REFERENCE_FIDELITY=false
VSN_FEATURE_BRAND_INTELLIGENCE_EXTRACTION=false

# Experimental feature flags. Developer SDK and enterprise hardening are enabled in this development example because their release QA suites validate those surfaces.
VSN_FEATURE_NATIVE_SECTION_BRIDGE=false
VSN_FEATURE_LIVE_E2E_HOOKS=false
VSN_FEATURE_QUERY_BUILDER_V2=false
VSN_FEATURE_COMPONENT_VARIANTS=false
VSN_FEATURE_RESPONSIVE_V2=false
VSN_FEATURE_COLLABORATION_REVIEW=false
VSN_FEATURE_LOCALIZATION_MARKETS=false
VSN_FEATURE_FORMS_AUTOMATION=false
VSN_FEATURE_MARKETPLACE_BRAND_KITS=false
VSN_FEATURE_DEVELOPER_SDK=true
VSN_FEATURE_ENTERPRISE_HARDENING=true
VSN_FEATURE_COMMERCIALIZATION=false

# Developer-plan simulation. Leave blank to use the built-in development default; never hard-code a paid tier in source.
VSN_DEFAULT_PLAN=

# Shopify hosted App Pricing destination. Configure these per deployed app/environment.
SHOPIFY_APP_HANDLE=
SHOPIFY_APP_PRICING_URL=

# Public Shopify App Pricing plan handles. These defaults match the current Shopify-hosted plan handles exactly; override only if the Partner configuration changes.
SHOPIFY_APP_PRICING_PLAN_FREE_HANDLE=free
SHOPIFY_APP_PRICING_PLAN_SILVER_HANDLE=sliver
SHOPIFY_APP_PRICING_PLAN_GOLD_HANDLE=gold
SHOPIFY_APP_PRICING_PLAN_PLATINUM_HANDLE=platenium

# Verified Shopify subscription sync. Keep Partner API credentials in the deployment secret store.
SHOPIFY_PARTNER_ORGANIZATION_ID=
SHOPIFY_PARTNER_API_TOKEN=
SHOPIFY_PARTNER_API_VERSION=2026-07
SHOPIFY_PARTNER_API_RETRY_COUNT=2
SHOPIFY_PARTNER_API_RETRY_BASE_MS=250
SHOPIFY_SUBSCRIPTION_CACHE_TTL_SECONDS=300
SHOPIFY_SUBSCRIPTION_MAX_STALE_SECONDS=86400

# Legacy fallback only. Prefer SHOPIFY_APP_HANDLE and SHOPIFY_APP_PRICING_URL for new deployments.
SHOPIFY_MANAGED_PRICING_URL=

# Secret encryption for stored provider/integration credentials. Set a strong deployment secret; never commit the real value.
VSN_SECRET_ENCRYPTION_KEY=

# Stock media provider credentials. All values are optional fallbacks and should be supplied via the deployment secret store.
UNSPLASH_ACCESS_KEY=
UNSPLASH_SECRET_KEY=
PEXELS_API_KEY=
PIXABAY_API_KEY=
FREESOUND_API_KEY=
SHUTTERSTOCK_CONSUMER_KEY=
SHUTTERSTOCK_CONSUMER_SECRET=
SHUTTERSTOCK_API_TOKEN=
GETTY_API_KEY=
GETTY_API_SECRET=

# Google platform integrations. Keep API and reCAPTCHA secret keys in the deployment secret store.
GOOGLE_MAPS_API_KEY=
VSN_RECAPTCHA_V2_SITE_KEY=
VSN_RECAPTCHA_V2_SECRET_KEY=
VSN_RECAPTCHA_V3_SITE_KEY=
VSN_RECAPTCHA_V3_SECRET_KEY=

# Form anti-abuse providers. Secrets must stay out of source control.
VSN_TURNSTILE_SECRET_KEY=
VSN_HCAPTCHA_SECRET_KEY=

# Optional outbound automation hooks. Only public HTTPS endpoints are accepted at runtime.
VSN_FORM_EMAIL_WEBHOOK_URL=
VSN_FORM_EMAIL_WEBHOOK_SECRET=
VSN_FORM_FILE_SCAN_WEBHOOK=
