{
  // Full React Router routes are enabled only in the protected Staging Worker
  // build. The production manifest and Worker entry remain independent.
  // Never enable previews or copy Staging credentials into Production.
  "name": "vsn-builder-staging",
  "main": "./workers/staging-full-app.js",
  "compatibility_date": "2026-10-13",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "send_metrics": false,
  // Persist Staging telemetry across source deployments. The protected T021
  // deploy workflow applies Cloudflare's query-string redaction after upload;
  // do not bypass that workflow for Staging. Production config is separate.
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "head_sampling_rate": 1,
      "persist": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true
    },
    "issues": {
      "enabled": true
    }
  },
  // Wrangler 4 validates these existing encrypted binding names before a
  // Staging deploy. Secret VALUES remain only in cloudflare-staging/Cloudflare.
  // Never add DIRECT_URL, migrations credentials or any Live secret here.
  "secrets": {
    "required": ["DATABASE_URL", "SHOPIFY_API_KEY", "SHOPIFY_API_SECRET", "SHOPIFY_PARTNER_API_TOKEN"]
  },
  "vars": {
    "APP_ENV": "staging",
    "VSN_WORKER_NAME": "vsn-builder-staging",
    "NEON_PROJECT_ID": "shiny-violet-61219572",
    "SHOPIFY_BILLING_TEST_MODE": "true",
    "SHOPIFY_APP_HANDLE": "vsn-builder-staging",
    "SHOPIFY_PARTNER_ORGANIZATION_ID": "4859256",
    "SHOPIFY_PARTNER_API_VERSION": "2026-07",
    "VSN_STAGING_BILLING_SYNC_ENABLED": "true",
    // T023: owner-directed Staging-only activation of SDK OAuth and the
    // dashboard and the draft editor. Draft saves are Staging-only; Production never sets these.
    "VSN_STAGING_OAUTH_ENABLED": "true",
    "VSN_STAGING_DASHBOARD_ENABLED": "true",
    "VSN_STAGING_DRAFT_SAVE_ENABLED": "true",
    "VSN_STAGING_REACT_ROUTER_ENABLED": "true"
  }
}
