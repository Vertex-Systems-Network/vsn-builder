{
  // Stage-only HTTPS endpoint exists, but merchant routes remain fail-closed
  // until the protected T018 migration, reviewed deploy and hosted acceptance.
  // Never enable previews or production workers.dev as a side effect.
  // Shopify secrets and Neon DATABASE_URL must be set via scoped secret
  // bindings; NEVER commit credentials to this file or use CLI deploy
  // until the protected environment and acceptance gates are verified.
  "name": "vsn-builder-staging",
  "main": "./workers/app.js",
  "compatibility_date": "2026-10-13",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "send_metrics": false,
  // Wrangler 4 validates these existing encrypted binding names before a
  // Staging deploy. Secret VALUES remain only in cloudflare-staging/Cloudflare.
  // Never add DIRECT_URL, migrations credentials or any Live secret here.
  "secrets": {
    "required": ["DATABASE_URL", "SHOPIFY_API_KEY", "SHOPIFY_API_SECRET"]
  },
  "vars": {
    "APP_ENV": "staging",
    "VSN_WORKER_NAME": "vsn-builder-staging",
    "NEON_PROJECT_ID": "shiny-violet-61219572",
    "SHOPIFY_BILLING_TEST_MODE": "true",
    // T023: owner-directed Staging-only activation of SDK OAuth and the
    // dashboard and the draft editor. Draft saves are Staging-only; Production never sets these.
    "VSN_STAGING_OAUTH_ENABLED": "true",
    "VSN_STAGING_DASHBOARD_ENABLED": "true",
    "VSN_STAGING_DRAFT_SAVE_ENABLED": "true"
  }
}
