# VSN Builder local development only. Copy to .env.local; DO NOT COMMIT .env.local.
# Register a distinct 'VSN | Builder (Development)' Shopify Partner app before starting.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
APP_ENV=development
SHOPIFY_BILLING_TEST_MODE=true
DATABASE_URL=file:./dev.sqlite
SCOPES=read_locales,read_markets,read_translations,write_translations,read_files,write_files,read_themes,write_themes,read_orders,read_online_store_pages,write_online_store_pages,read_products,write_products,write_app_proxy,write_metaobject_definitions,read_metaobject_definitions,write_metaobjects,read_metaobjects
# Shopify CLI manages SHOPIFY_APP_URL using the ephemeral development tunnel.
# Never include Staging/Production Neon/Cloudflare/Shopify secrets here.
