{
  // Phase 4 gated integration only. No merchant app release or public URL.
  // Shopify secrets and Neon DATABASE_URL must be set via scoped secret
  // bindings; NEVER commit credentials to this file or use CLI deploy
  // until the protected environment and acceptance gates are verified.
  "name": "vsn-builder-production",
  "main": "./workers/app.js",
  "compatibility_date": "2026-10-13",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "send_metrics": false,
  "vars": {
    "APP_ENV": "production",
    "VSN_WORKER_NAME": "vsn-builder-production",
    "NEON_PROJECT_ID": "nameless-violet-68750490",
    "SHOPIFY_BILLING_TEST_MODE": "false"
  }
}
