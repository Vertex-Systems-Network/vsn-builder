  lastSyncAt          DateTime?
  lastSyncError       String?
  lastSyncErrorAt     DateTime?
  snapshotJson        String?
  trialEndsAt         DateTime?
  startedAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([provider, status, verifiedAt])
}

