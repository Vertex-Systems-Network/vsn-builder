  deletedAt    DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([shop, deletedAt, updatedAt])
  @@index([shop, category])
}

model BuilderDiagnosticEvent {
  id        String   @id @default(cuid())
