}

model BuilderRequestLog {
  id         String   @id @default(cuid())
  shop       String
  requestId  String   @unique
  route      String
  method     String
  status     Int?
  durationMs Int?
  message    String?
  createdAt  DateTime @default(now())

  @@index([shop, createdAt])
  @@index([route, createdAt])
}

model BuilderCleanupRun {
  id        String   @id @default(cuid())
  shop      String
  status    String   @default("completed")
