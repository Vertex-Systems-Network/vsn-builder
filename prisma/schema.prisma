  @@index([shop, template, enabled, priority])
  @@index([shop, pageId])
}


model BuilderSubscription {
  id                  String   @id @default(cuid())
  shop                String   @unique
  planKey             String   @default("free")
  status              String   @default("active")
  provider            String?
  planHandle          String?
  billingPeriod       String?
  cancelAtEndOfCycle  Boolean  @default(false)
  cancelEffectiveOn   DateTime?
  currentCycleStart   DateTime?
  currentCycleEnd     DateTime?
  pendingPlanKey      String?
  pendingPlanHandle   String?
  pendingBillingPeriod String?
