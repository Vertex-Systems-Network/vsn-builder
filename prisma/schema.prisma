  @@index([shop, createdAt])
}


model BuilderFormSubmission {
  id            String   @id @default(cuid())
  shop          String
  formKey       String   @default("contact")
  pageUrl       String?
  productHandle String?
  customerEmail String?
  fieldsJson    String
  readAt        DateTime?
