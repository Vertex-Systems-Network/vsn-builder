  @@index([shop, createdAt])
  @@index([shop, formKey, createdAt])
  @@index([shop, isSpam, createdAt])
  @@index([shop, requesterHash, createdAt])
  @@index([shop, deliveryStatus, createdAt])
}

model BuilderLibraryItem {
  id          String   @id @default(cuid())
  shop        String
  title       String
  kind        String   @default("section")
  category    String   @default("General")
  syncMode    String   @default("local")
  contentJson String
  thumbnail   String?
  templateType String?
  isFavorite  Boolean  @default(false)
  sourceKey   String?
  sourceVersion Int    @default(1)
  industry    String?
  style       String?
  planTier    String   @default("free")
  colorTags   String?
  layoutTags  String?
  description String?
  qualityScore Int?
  compatibilityJson String?
  screenshotJson String?
  source      String   @default("local")
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  @@index([shop, kind, updatedAt])
  @@index([shop, category, updatedAt])
  @@index([shop, templateType, updatedAt])
  @@index([shop, isFavorite, updatedAt])
  @@index([shop, deletedAt, updatedAt])
  @@index([shop, sourceKey])
  @@index([shop, industry, style])
  @@index([shop, planTier, updatedAt])
}

model BuilderTemplateRule {
  id          String   @id @default(cuid())
  shop        String
  pageId      String
