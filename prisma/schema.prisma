  @@index([shop, status, updatedAt])
}

model BuilderSupportMessage {
  id          String   @id @default(cuid())
  shop        String
  ticketId    String
  authorType  String   @default("merchant")
  authorName  String?
  body        String
  createdAt   DateTime @default(now())
  ticket      BuilderSupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
  @@index([shop, createdAt])
}

model BuilderCustomFont {
  id        String   @id @default(cuid())
  shop      String
  family    String
  weight    Int      @default(400)
  style     String   @default("normal")
  fileName  String
  mimeType  String
