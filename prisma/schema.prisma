  winnerVariantId     String?
  startedAt           DateTime?
  endedAt             DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  variants            BuilderExperimentVariant[]

  @@index([shop, status, updatedAt])
  @@index([shop, pageId, status])
}

