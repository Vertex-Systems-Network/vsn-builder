  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  @@unique([shop, family, weight, style])
  @@index([shop, deletedAt, family])
  @@index([shop, family])
}

model BuilderExperiment {
  id                  String   @id @default(cuid())
  shop                String
