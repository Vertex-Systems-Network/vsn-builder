{
  // Strictly local workerd module compatibility; not a deployable Builder app.
  "name": "vsn-builder-disposable-ci-probe",
  "main": "./workers/ci-worker-compat.js",
  "compatibility_date": "2026-10-13",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "send_metrics": false,
  "dev": {"ip": "127.0.0.1", "port": 8788},
  "vars": {"APP_ENV": "development"}
}
